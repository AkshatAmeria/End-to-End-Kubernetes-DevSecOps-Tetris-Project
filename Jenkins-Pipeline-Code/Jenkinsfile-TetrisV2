pipeline {
    agent any
    tools {
        nodejs 'nodejs'
    }
    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }
    stages {
        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout from Git') {
            steps {
                git branch: 'master', url: 'https://github.com/AkshatAmeria/End-to-End-Kubernetes-DevSecOps-Tetris-Project.git'
            }
        }
        stage('Sonarqube Analysis') {
            steps {
                dir('Tetris-V2') {
                    withSonarQubeEnv('sonar-server') {
                        sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=Tetris-V2 \
                        -Dsonar.projectKey=Tetris-V2 '''
                    }
                }
            }
        }
        stage('Quality Check') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        stage('Installing Dependencies') {
            steps {
                dir('Tetris-V2') {
                    sh 'npm install'
                }
            }
        }
        // Disabled until an NVD API key and a newer Dependency-Check version are set up.
        // To re-enable: delete the "when" block below.
        stage('OWASP Dependency-Check Scan') {
            when { expression { false } }
            steps {
                dir('Tetris-V2') {
                    dependencyCheck additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit', odcInstallation: 'DP-Check'
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }
        stage('Trivy File Scan') {
            steps {
                dir('Tetris-V2') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }
        stage('Docker Image Build') {
            steps {
                script {
                    dir('Tetris-V2') {
                        withDockerRegistry(credentialsId: 'docker') {
                            sh 'docker system prune -f'
                            sh 'docker build -t tetrisv2 .'
                        }
                    }
                }
            }
        }
        stage('Docker Image Pushing') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker') {
                        sh 'docker tag tetrisv2 akshatameria/tetrisv2:${BUILD_NUMBER}'
                        sh 'docker push akshatameria/tetrisv2:${BUILD_NUMBER}'
                    }
                }
            }
        }
        stage('TRIVY Image Scan') {
            steps {
                sh 'trivy image akshatameria/tetrisv2:${BUILD_NUMBER} > trivyimage.txt'
            }
        }
        stage('Checkout Code') {
            steps {
                git branch: 'master', url: 'https://github.com/AkshatAmeria/End-to-End-Kubernetes-DevSecOps-Tetris-Project.git'
            }
        }
        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = "End-to-End-Kubernetes-DevSecOps-Tetris-Project"
                GIT_USER_NAME = "AkshatAmeria"
            }
            steps {
                dir('Manifest-file') {
                    withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "1201.akshat@gmail.com"
                            git config user.name "AkshatAmeria"
                            echo "Build number: ${BUILD_NUMBER}"
                            echo "Image line before:"
                            grep "image:" deployment-service.yml
                            sed -i "s|image: akshatameria/tetris.*|image: akshatameria/tetrisv2:${BUILD_NUMBER}|" deployment-service.yml
                            echo "Image line after:"
                            grep "image:" deployment-service.yml
                            git add deployment-service.yml
                            git commit -m "Update deployment image to tetrisv2:${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:master
                        '''
                    }
                }
            }
        }
    }
}